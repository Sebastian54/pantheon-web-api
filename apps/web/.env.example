NEXT_PUBLIC_API_URL=https://api.archer.software

# Auth.js (NextAuth)
NEXTAUTH_URL=https://archer.software
NEXTAUTH_SECRET=

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mailgun (transactional email — verification links, etc.)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Only set if the Mailgun domain is EU-region: https://api.eu.mailgun.net
MAILGUN_API_BASE=

# Database (Postgres + TimescaleDB) — provided by packages/db
DATABASE_URL=postgres://pantheon:pantheon@localhost:5432/pantheon

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
