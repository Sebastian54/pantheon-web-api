NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# CORS: comma-separated list of allowed origins (the dashboard's domain)
CORS_ORIGIN=https://archer.software

# Database (Postgres + TimescaleDB) — provided by packages/db
DATABASE_URL=postgres://pantheon:pantheon@localhost:5432/pantheon

# Shared with apps/web — required to decode NextAuth session tokens
# forwarded as a Bearer token on OWNER-gated requests.
NEXTAUTH_SECRET=

# Sentry
SENTRY_DSN=

# Mailgun — used by POST /auth/mobile/register to send its own verification email
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Only set if the Mailgun domain is EU-region: https://api.eu.mailgun.net
MAILGUN_API_BASE=
