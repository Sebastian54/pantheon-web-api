# Production environment for docker-compose.prod.yml — one file, consumed by
# every service via `env_file`. Copy to `.env.production` and fill in real
# values; `.env.production` itself is gitignored, this .example file is not.
#
# Usage:
#   cp .env.production.example .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# ==============================================================================
# Database — used both for compose-level DATABASE_URL construction and
# directly by the postgres service itself.
# ==============================================================================
POSTGRES_USER=pantheon
POSTGRES_PASSWORD=
POSTGRES_DB=pantheon

# ==============================================================================
# Auth — shared secret between apps/api and apps/web (apps/api decodes the
# session token apps/web issues, so these must match exactly).
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
# ==============================================================================
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://archer.software

# Discord OAuth app (Discord Developer Portal) — redirect URI must be
# https://archer.software/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ==============================================================================
# API (apps/api)
# ==============================================================================
CORS_ORIGIN=https://archer.software
SENTRY_DSN=

# ==============================================================================
# Web (apps/web) — the NEXT_PUBLIC_* and SENTRY_ORG/SENTRY_PROJECT values
# below are also consumed as Docker build args (see docker-compose.prod.yml)
# since they get inlined into the client bundle at build time, not read at
# container runtime.
# ==============================================================================
NEXT_PUBLIC_API_URL=https://api.archer.software
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN is intentionally not included: it would need to be a
# Docker build arg to be useful, and build args are baked into image layer
# history — not appropriate for a secret. Source map upload is skipped in
# this setup; Sentry still captures errors, just without deobfuscated traces.

# ==============================================================================
# Cloudflare Tunnel — from the Zero Trust dashboard, Networks > Tunnels.
# The tunnel's Public Hostname routes (archer.software -> web:3000,
# api.archer.software -> api:4000) are configured on Cloudflare's side, not
# in this file — see the deployment guide.
# ==============================================================================
CLOUDFLARE_TUNNEL_TOKEN=
